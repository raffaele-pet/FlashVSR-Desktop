<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FlashVSRDesktop</AssemblyName><RootNamespace>FlashVsr.Desktop</RootNamespace>
    <ApplicationIcon>Assets\flashvsr.ico</ApplicationIcon>
    <Version>1.0.0</Version><Description>FlashVSR+ desktop video super-resolution</Description>
    <PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\flashvsr.png"/><Resource Include="Assets\flashvsr.ico"/>
    <EmbeddedResource Include="..\bridge\presets.json" LogicalName="presets.json"/>
    <EmbeddedResource Include="Assets\engine.zip" Condition="Exists('Assets\engine.zip')" LogicalName="engine.zip"/>
  </ItemGroup>
</Project>
