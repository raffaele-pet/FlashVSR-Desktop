<UserControl x:Class="FlashVsr.Desktop.Views.ComparisonPlayer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="Viewport" Background="#07080B" ClipToBounds="True" SizeChanged="Viewport_SizeChanged" MinHeight="200">
   <Rectangle x:Name="BeforeFrame"/>
   <Rectangle x:Name="AfterFrame"/>
   <Image x:Name="Poster" Stretch="Uniform" IsHitTestVisible="False"/>
   <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="32" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="Drop a video here" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,6"/><TextBlock Text="or browse files" Style="{StaticResource Caption}" HorizontalAlignment="Center"/></StackPanel>
   <Border x:Name="PreviewMessage" Visibility="Collapsed" Background="#DC101216" CornerRadius="5" Padding="12,7" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16"><TextBlock x:Name="PreviewMessageText" Style="{StaticResource Caption}"/></Border>
   <Grid x:Name="Divider" Visibility="Collapsed" Width="32" HorizontalAlignment="Left" Background="Transparent"><Border Width="1" Background="#F0FFFFFF" HorizontalAlignment="Center"/><Border Width="30" Height="40" Background="#E51B1D24" BorderBrush="#B0FFFFFF" BorderThickness="1" CornerRadius="15" VerticalAlignment="Center"><TextBlock Text="‹ ›" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Thumb x:Name="SplitThumb" Cursor="SizeWE" DragDelta="Split_DragDelta" AutomationProperties.Name="Comparison divider"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template></Thumb></Grid>
   <Border x:Name="BeforeBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="8,4" Background="#B0101216" CornerRadius="4"><TextBlock Text="Before" FontSize="11"/></Border>
   <Border x:Name="AfterBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Padding="8,4" Background="#B0101216" CornerRadius="4"><TextBlock Text="After" FontSize="11"/></Border>
  </Grid>
  <Grid Grid.Row="1" Margin="16,12,16,2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PlayButton" Style="{StaticResource Quiet}" Click="Play_Click" IsEnabled="False" Width="36" Padding="8" ToolTip="Play / pause (Space)" AutomationProperties.Name="Play or pause"><TextBlock x:Name="PlayIcon" FontFamily="Segoe Fluent Icons" Text="&#xE768;" FontSize="16"/></Button><Slider x:Name="SeekBar" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="1" IsEnabled="False" IsMoveToPointEnabled="True" Margin="8,0,14,0" ValueChanged="Seek_ValueChanged" PreviewMouseLeftButtonDown="Seek_Down" PreviewMouseLeftButtonUp="Seek_Up" AutomationProperties.Name="Video timeline"/><TextBlock x:Name="TimeLabel" Grid.Column="2" Text="00:00 / 00:00" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontFamily="Consolas"/></Grid>
  <Grid Grid.Row="2" Margin="16,4,16,12"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><RadioButton x:Name="BeforeMode" Content="Before" GroupName="Compare" Style="{StaticResource Segment}" IsChecked="True" Checked="Mode_Changed"/><RadioButton x:Name="AfterMode" Content="After" GroupName="Compare" Style="{StaticResource Segment}" IsEnabled="False" Checked="Mode_Changed"/><RadioButton x:Name="SlideMode" Content="Slide" GroupName="Compare" Style="{StaticResource Segment}" IsEnabled="False" Checked="Mode_Changed"/></StackPanel><Button x:Name="FullscreenButton" Style="{StaticResource Quiet}" HorizontalAlignment="Right" Click="Fullscreen_Click" Padding="10,7" ToolTip="Full screen (F11)" AutomationProperties.Name="Full screen"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE740;" FontSize="14"/></Button></Grid>
 </Grid>
</UserControl>
