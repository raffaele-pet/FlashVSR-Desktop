<Window x:Class="FlashVsr.Desktop.Views.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Installa FlashVSR Desktop" Width="1020" Height="800" MinWidth="940" MinHeight="720" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#11121F" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="30"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><Image Source="/Assets/flashvsr.png" Width="66" Height="66" HorizontalAlignment="Left"/><TextBlock Text="FlashVSR+" FontSize="29" FontWeight="SemiBold" Margin="0,22,0,0"/><TextBlock Text="DESKTOP / INSTALLAZIONE" Style="{StaticResource Eyebrow}" Margin="0,7,0,0"/><TextBlock Text="Tutto pronto.&#10;Senza terminale." FontSize="27" FontWeight="SemiBold" Margin="0,55,0,16"/><TextBlock Text="Un ambiente isolato, il motore AI e il modello Turbo. Ci occupiamo noi delle dipendenze." Foreground="{StaticResource Muted}" LineHeight="23"/><Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,32,0,0" Padding="0,22,0,0"><TextBlock Text="Windows 10/11 · x64&#10;GPU NVIDIA Ampere o successiva&#10;12 GB VRAM consigliati&#10;32 GB RAM consigliati&#10;Almeno 22 GB liberi" Style="{StaticResource Caption}" LineHeight="24"/></Border></StackPanel><StackPanel Grid.Row="2"><TextBlock Text="I video vengono elaborati sul PC.&#10;Nessun caricamento su servizi esterni." Style="{StaticResource Caption}"/><TextBlock Text="FlashVSR Desktop · v1.0.0" Style="{StaticResource Caption}" FontSize="10" Margin="0,15,0,0"/></StackPanel></Grid></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26,32,24">
   <TextBlock Text="Configura il tuo spazio." FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Il primo avvio scarica circa 10 GB. I download interrotti possono essere ripresi." Style="{StaticResource Caption}" Margin="0,8,0,18"/>
   <StackPanel x:Name="FolderPanel"><TextBlock Text="Cartella di installazione" FontWeight="SemiBold" Margin="0,0,0,7"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBox x:Name="RootBox" FontSize="11" AutomationProperties.Name="Cartella di installazione"/><Button Grid.Column="2" Content="…" Padding="0" Click="Root_Click"/></Grid>
    <Expander Header="Hai già scaricato i modelli?" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,11,0,8"><StackPanel Margin="0,10,0,0"><TextBlock Text="Facoltativo: seleziona una cartella FlashVSR che contenga ckpts. I pesi verranno verificati e riutilizzati." Style="{StaticResource Caption}"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBox x:Name="ReuseBox" FontSize="11" AutomationProperties.Name="Modelli esistenti"/><Button Grid.Column="2" Content="…" Padding="0" Click="Reuse_Click"/></Grid></StackPanel></Expander>
    <CheckBox x:Name="DesktopCheck" Content="Crea un collegamento sul desktop" IsChecked="True" Margin="0,8,0,17"/>
   </StackPanel>
   <Border Style="{StaticResource Card}" Padding="16,11"><ItemsControl x:Name="StepsList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Symbol}" Foreground="{Binding Color}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"/><TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding Color}" FontSize="10" TextAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
   <TextBlock x:Name="SetupStatus" Text="Pronto per iniziare." FontSize="12" FontWeight="SemiBold" Margin="0,15,0,9"/><ProgressBar x:Name="SetupProgress" Minimum="0" Maximum="100"/>
   <Grid Margin="0,16,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><Button x:Name="CancelButton" Content="Chiudi" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Click="Cancel_Click"/><Button x:Name="InstallButton" Grid.Column="2" Content="Installa FlashVSR" Style="{StaticResource Primary}" Click="Install_Click"/></Grid>
   <Expander Header="Dettagli e dipendenze" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"><TextBox x:Name="SetupLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="125" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10" Margin="0,9,0,0"/></Expander>
   <Button Content="Driver NVIDIA ↗" Style="{StaticResource Quiet}" HorizontalAlignment="Left" FontSize="11" Margin="-9,5,0,0" Click="Driver_Click" ToolTip="Installazione ufficiale del driver, necessaria se non è presente una GPU NVIDIA pronta"/>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>
