<Window x:Class="FlashVsr.Desktop.Views.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="FlashVSR Desktop — Setup" Width="780" Height="840" MinWidth="700" MinHeight="730" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26,32,24">
  <StackPanel Orientation="Horizontal" Margin="0,0,0,26"><Image Source="/Assets/flashvsr.png" Width="32" Height="36" Margin="0,0,12,0"/><TextBlock Text="FlashVSR+" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="DESKTOP" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,4,0,0"/></StackPanel>
  <TextBlock Text="Installation" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Windows 10/11 x64 · NVIDIA RTX 30 or newer · 22 GB free" Style="{StaticResource Caption}" Margin="0,8,0,6"/><TextBlock Text="First installation downloads about 10 GB. Interrupted downloads can resume." Style="{StaticResource Caption}" Margin="0,0,0,24"/>
  <StackPanel x:Name="FolderPanel"><TextBlock Text="Install location" FontWeight="SemiBold" Margin="0,0,0,9"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBox x:Name="RootBox" FontSize="12" AutomationProperties.Name="Install location"/><Button Grid.Column="2" Content="…" Padding="0" Click="Root_Click" ToolTip="Choose install location"/></Grid>
   <Expander Header="Reuse existing models" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,8"><StackPanel Margin="0,10,0,0"><TextBlock Text="Optional: select a FlashVSR folder containing ckpts." Style="{StaticResource Caption}"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBox x:Name="ReuseBox" FontSize="12" AutomationProperties.Name="Existing models"/><Button Grid.Column="2" Content="…" Padding="0" Click="Reuse_Click" ToolTip="Choose existing models"/></Grid></StackPanel></Expander>
   <CheckBox x:Name="DesktopCheck" Content="Create desktop shortcut" IsChecked="True" Margin="0,8,0,22"/>
  </StackPanel>
  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="0,8"><ItemsControl x:Name="StepsList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Symbol}" Foreground="{Binding Color}"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"/><TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding Color}" FontSize="11" TextAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
  <TextBlock x:Name="SetupStatus" FontSize="12" Margin="0,16,0,10"/><ProgressBar x:Name="SetupProgress" Minimum="0" Maximum="100"/>
  <Grid Margin="0,20,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="CancelButton" Content="Close" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Click="Cancel_Click"/><Button x:Name="InstallButton" Grid.Column="1" Content="Install FlashVSR" Width="180" Style="{StaticResource Primary}" Click="Install_Click"/></Grid>
  <Expander Header="Installation log" Foreground="{StaticResource Muted}" FontSize="11"><TextBox x:Name="SetupLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="120" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10" Margin="0,9,0,0"/></Expander>
  <Button Content="NVIDIA driver ↗" Style="{StaticResource Quiet}" HorizontalAlignment="Left" FontSize="11" Margin="-9,8,0,0" Click="Driver_Click"/>
 </StackPanel></ScrollViewer>
</Window>
